% Shared look for the EpiScope group pack: title block, footer with page numbers and draft stamp.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pack}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[a4paper,margin=2.2cm,footskip=1.2cm]{geometry}
\RequirePackage{amssymb,microtype,booktabs,tabularx,longtable,enumitem,xcolor,fancyhdr,lastpage}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage[most]{tcolorbox}
\definecolor{accent}{HTML}{0072B2}
\definecolor{cue}{HTML}{E8F1F8}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{2em}
\setlength{\parskip}{0.55em}
\setlist{nosep,leftmargin=1.4em}
\newlist{checklist}{itemize}{1}
\setlist[checklist]{label=$\square$,nosep,leftmargin=1.6em}
\renewcommand{\arraystretch}{1.15}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{F}{>{\raggedright\arraybackslash}p{4.8cm}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize EpiScope, CSE 4345}
\fancyfoot[C]{\footnotesize Draft v0.1, 20 Oct 2026}
\fancyfoot[R]{\footnotesize Page \thepage\ of \pageref*{LastPage}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[L]{\footnotesize EpiScope, CSE 4345}%
  \fancyfoot[C]{\footnotesize Draft v0.1, 20 Oct 2026}\fancyfoot[R]{\footnotesize Page \thepage\ of \pageref*{LastPage}}}
\newcommand{\titleblock}[2]{%
  {\color{accent}\rule{\linewidth}{1.2pt}}\par\vspace{0.2em}
  {\footnotesize\textsc{CSE 4345 Big Data Analytics \textbullet\ CEP EpiScope \textbullet\ Group of four}}\par
  {\LARGE\bfseries #1\par}\vspace{0.2em}
  {\small #2\par}
  {\color{accent}\rule{\linewidth}{0.6pt}}\par\vspace{0.6em}}
\newcommand{\showcue}[1]{\begin{tcolorbox}[colback=cue,colframe=accent,boxrule=0.4pt,left=4pt,right=4pt,top=2pt,bottom=2pt,arc=1pt]
  \small\textbf{SHOW:} #1\end{tcolorbox}}
\newtcolorbox{teammate}[1]{colback=yellow!12,colframe=orange!70!black,boxrule=0.5pt,arc=1pt,
  title={\small\bfseries TEAMMATE: #1},fonttitle=\small,left=4pt,right=4pt,top=2pt,bottom=2pt}
\endinput
