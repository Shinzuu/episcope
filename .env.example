# Copy to .env and fill in. Never commit .env (PRV-1).
EPISCOPE_HASH_SALT=change-me-to-a-long-random-string
# Root folders (local paths; file:// is added by the code)
EPISCOPE_DATA_DIR=./data
EPISCOPE_LAKE_DIR=./lake
# Optional: Spark spill folder (default /tmp). Set to a disk folder when /tmp is a small RAM tmpfs (SF=1 silver).
# EPISCOPE_SPARK_LOCAL_DIR=/var/tmp/episcope-spark
